// Игра: угадай число! 🎲
импорт рандом

пусть секрет число = рандом.число 1, 100
пусть попытки число = 0
пусть угадал бул = ложь

печать цвет.радуга "Загадано число от 1 до 100!"

пока не угадал
    пусть ответ число = ввод "Твоя догадка: " или 0
    попытки = попытки плюс 1

    если ответ равно секрет
        печать "🎉 Угадал за {попытки} попыток!" цвет зелёный жирный
        угадал = истина
    иначе если ответ больше секрет
        печать "⬇ Меньше!" цвет янтарь
    иначе
        печать "⬆ Больше!" цвет янтарь
