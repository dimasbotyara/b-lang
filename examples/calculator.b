// Простой калькулятор
импорт математика

печать "=== Калькулятор ===" цвет бирюзовый жирный

пусть a число = ввод "Первое число: " или 0
пусть b число = ввод "Второе число: " или 0

печать "Сумма: {a плюс b}" цвет зелёный
печать "Разность: {a минус b}" цвет янтарь
печать "Произведение: {a умножить b}" цвет синий

если b не_равно 0
    печать "Частное: {a делить b}" цвет лиловый
иначе
    предупреждение "Деление на ноль пропущено"

печать "Корень из a: {математика.корень a}" цвет изумрудный
